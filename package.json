{
  "name": "cliproam",
  "version": "0.2.7",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "debug:app": "pnpm --filter @cliproam/protocol build && cargo build --manifest-path apps/app/src-tauri/Cargo.toml",
    "dev:app:mac": "pnpm --filter @cliproam/app macos:dev",
    "build:app:mac": "pnpm --filter @cliproam/app macos:build",
    "debug:server": "pnpm --filter @cliproam/protocol build && pnpm --filter @cliproam/server debug",
    "debug:vscode": "pnpm build:vscode && code --new-window --extensionDevelopmentPath=apps/vscode",
    "build:server": "pnpm --filter @cliproam/server build",
    "build:pwa": "pnpm --filter @cliproam/pwa build",
    "build:chrome": "pnpm --filter @cliproam/chrome build",
    "build:firefox": "pnpm --filter @cliproam/firefox build",
    "build:vscode": "pnpm --filter ./apps/vscode build",
    "package:vscode": "pnpm --filter ./apps/vscode package",
    "docker": "node scripts/docker.js",
    "docker:publish": "node scripts/docker.js publish",
    "release": "node scripts/release.js",
    "sync:versions": "node scripts/sync-versions.js",
    "sync:icons": "node scripts/sync-icons.js",
    "check": "pnpm --filter @cliproam/protocol build && pnpm -r check"
  }
}
