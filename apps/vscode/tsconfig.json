{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "isolatedModules": true, "noEmit": true, "skipLibCheck": true,
    "resolveJsonModule": true, "types": ["vite/client"]
  },
  "include": ["src/webview/**/*.ts", "src/webview/**/*.vue"]
}
