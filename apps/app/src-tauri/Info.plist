<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- 客户端支持直连用户任填的明文 HTTP 服务器（syncClient.ts 默认 http://ip:port），
         macOS 的 ATS 默认拦截非 HTTPS 连接，这里整体放行，
         与 Android 的 usesCleartextTraffic="true" 对应。 -->
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <true/>
    </dict>
    <!-- iOS 14+ / macOS 15+ 访问局域网设备需要本地网络权限，
         没有这个声明的话直连 http://192.168.x.x:port 会静默失败。 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>ClipRoam 需要访问本地网络以连接你的剪贴板同步服务器。</string>
  </dict>
</plist>
