{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipRoam",
  "version": "../../../package.json",
  "identifier": "com.while.cliproam",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ClipRoam",
        "width": 960,
        "height": 700,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": true
      },
      {
        "label": "paste",
        "create": false,
        "title": "ClipRoam - 快速粘贴",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "decorations": false
      },
      {
        "label": "toast",
        "create": false,
        "title": "ClipRoam",
        "width": 380,
        "height": 88,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "shadow": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/histories/*/files/upload/images/*",
          "$APPDATA/histories/*/files/download/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "while",
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English", "TradChinese"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEN0M3NkIyM0MwRUFEQzYKUldUR3JRNDhzblo4alZ4dVRCUHJzekJPUUgwUG9SaVdJT2hDcytnQStBdkY2UkxhN1FhMUxvN1AK",
      "endpoints": [
        "https://github.com/while-coder/ClipRoam/releases/download/updater/latest.json"
      ]
    }
  }
}
