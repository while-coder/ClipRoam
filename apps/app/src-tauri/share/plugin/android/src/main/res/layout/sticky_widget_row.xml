<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sticky_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="2dp" android:paddingVertical="5dp"
    android:background="@drawable/sticky_widget_touch">
    <ImageView android:id="@+id/sticky_thumbnail" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginEnd="6dp" android:scaleType="fitCenter" android:visibility="gone" />
    <TextView android:id="@+id/sticky_note" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/sticky_widget_text" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
