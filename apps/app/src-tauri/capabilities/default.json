{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the ClipRoam main and toast windows",
  "windows": ["main", "toast"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "core:default",
    "log:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "process:default",
    "updater:default"
  ]
}
