{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the ClipRoam main, quick-paste, and toast windows",
  "windows": ["main", "paste", "toast"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "core:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "process:default",
    "updater:default"
  ]
}
