{
  "name": "@cliproam/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @cliproam/protocol build && node ../../scripts/stop-dev.mjs --port 1430",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:init": "tauri android init --ci",
    "android:build": "tauri android build --apk --ci",
    "ios:init": "tauri ios init --ci",
    "ios:build": "tauri ios build --ci"
  },
  "dependencies": {
    "@cliproam/protocol": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
