{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ClipRoam: stop web",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/stop-dev.mjs",
        "--port",
        "1430"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ClipRoam: stop app",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/stop-dev.mjs",
        "--executable",
        "${workspaceFolder}/apps/desktop/src-tauri/target/debug/cliproam"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "debug:server",
      "type": "shell",
      "command": "pnpm run debug:server",
      "options": { "cwd": "${workspaceFolder}" },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "build:admin",
      "type": "shell",
      "command": "pnpm --filter @cliproam/admin build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "ClipRoam: build app dev",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--manifest-path=${workspaceFolder}/apps/desktop/src-tauri/Cargo.toml"
      ],
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "ClipRoam: dev app",
      "type": "process",
      "command": "pnpm",
      "args": ["dev:app"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["ClipRoam: stop web"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": ".+" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "Local.*1430"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "ClipRoam: prep app dev",
      "dependsOn": ["ClipRoam: stop app", "ClipRoam: build app dev", "ClipRoam: dev app"],
      "dependsOrder": "sequence"
    },
    {
      "label": "launch:server",
      "dependsOn": ["debug:server", "build:admin"],
      "dependsOrder": "sequence"
    }
  ]
}
