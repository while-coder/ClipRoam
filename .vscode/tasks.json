{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui:kill",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/kill-port.js", "1430"],
      "problemMatcher": []
    },
    {
      "label": "server:kill",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/kill-port.js", "4810"],
      "problemMatcher": []
    },
    {
      "label": "debug:server",
      "type": "shell",
      "command": "pnpm run debug:server",
      "options": { "cwd": "${workspaceFolder}" },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "build:admin",
      "type": "shell",
      "command": "pnpm --filter @cliproam/admin build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "rust:build:dev",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--manifest-path=${workspaceFolder}/apps/app/src-tauri/Cargo.toml"
      ],
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "ui:dev",
      "type": "shell",
      "isBackground": true,
      "command": "pnpm",
      "args": ["vite", "dev", "--port", "1430"],
      "options": { "cwd": "${workspaceFolder}/apps/app" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": ".+" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "Local.*1430"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "tauri:before:dev",
      "dependsOn": ["ui:kill", "rust:build:dev", "ui:dev"],
      "dependsOrder": "sequence"
    },
    {
      "label": "launch:server",
      "dependsOn": ["server:kill", "debug:server", "build:admin"],
      "dependsOrder": "sequence"
    }
  ]
}
