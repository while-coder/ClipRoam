{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Web/Pwa",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:1431",
      "webRoot": "${workspaceFolder}/apps/pwa",
      "preLaunchTask": "pwa:dev"
    },
    {
      "name": "Launch VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/extension.js"],
      "preLaunchTask": "build:vscode"
    },
    {
      "name": "Launch Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/server/debug/index.js",
      "cwd": "${workspaceFolder}/apps/server",
      "preLaunchTask": "launch:server",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/server/debug/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch App · Windows",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/apps/app/src-tauri/target/debug/cliproam.exe",
      "cwd": "${workspaceFolder}/apps/app/src-tauri",
      "preLaunchTask": "tauri:before:dev"
    },
    {
      "name": "Launch App · Android",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @cliproam/app android:dev",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ui:kill"
    },
    {
      "name": "Launch App · macOS",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/apps/app/src-tauri/target/debug/cliproam",
      "cwd": "${workspaceFolder}/apps/app/src-tauri",
      "preLaunchTask": "tauri:before:dev"
    }
  ]
}
