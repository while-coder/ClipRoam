{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Server",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/apps/server/src/index.ts",
      "cwd": "${workspaceFolder}/apps/server",
      "preLaunchTask": "ClipRoam: prep server dev",
      "env": {
        "CLIPROAM_ADMIN_PASSWORD": "admin"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch App",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/apps/desktop/src-tauri/target/debug/cliproam.exe",
      "cwd": "${workspaceFolder}/apps/desktop/src-tauri",
      "preLaunchTask": "ClipRoam: prep app dev"
    }
  ]
}
